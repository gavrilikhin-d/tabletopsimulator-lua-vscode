{
	"parser": "@typescript-eslint/parser",
	"parserOptions": {
		"ecmaVersion": 6,
		"sourceType": "module",
		"project": "./tsconfig.json"
	},
	"env": {
		"node": true
	},
	"extends": [
		"standard-with-typescript",
		"plugin:prettier/recommended"
	],
	"rules": {
		"curly": "warn",
		"eqeqeq": "error",
		"max-len": ["warn", {
      "code": 100,
      "ignoreComments": true,
      "ignoreUrls": true,
      "ignoreStrings": true,
      "ignoreTemplateLiterals": true
    }],
		"prettier/prettier": "error"
	}
}
